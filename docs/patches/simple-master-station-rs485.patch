diff --git a/simple_master.h b/simple_master.h
index 1ef0091..f09c723 100644
--- a/simple_master.h
+++ b/simple_master.h
@@ -15,10 +15,19 @@
 #ifndef SMODBUS_SERIAL_INT
   #define SMODBUS_SERIAL_INT SMODBUS_INT_RDA   // Select between external interrupt
 #endif
+#ifndef SMODBUS_STOP_BITS
+ #define SMODBUS_STOP_BITS 2
+#endif
+
 #ifndef SMODBUS_BAUD
  #define SMODBUS_BAUD            9600
 #endif
 
+#ifndef SMODBUS_WAIT_TX_DONE
+ // Conservative fallback: shift register plus UART holding register, 8N2.
+ #define SMODBUS_WAIT_TX_DONE() delay_us((22000000UL+SMODBUS_BAUD-1)/SMODBUS_BAUD)
+#endif
+
 #ifndef SMODBUS_TX_PIN
  #define SMODBUS_TX_PIN          PIN_C6
 #endif
