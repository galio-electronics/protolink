{
  "folders": [
    {
      "name": "Station RTC SD",
      "path": "."
    },
    {
      "name": "Protolink common",
      "path": "../../common"
    }
  ],
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "RTC SD: Compilar",
        "type": "process",
        "command": "powershell.exe",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "${workspaceFolder:Station RTC SD}/../../../tools/run.ps1",
          "build",
          "--config",
          "${workspaceFolder:Station RTC SD}/config/project.json"
        ],
        "problemMatcher": [
          {
            "owner": "ccs",
            "source": "CCS 5.081",
            "fileLocation": "absolute",
            "pattern": {
              "regexp": "^(.*):(\\d+):(\\d+):\\s+(error|warning) CCS(\\d+): (.*)$",
              "file": 1,
              "line": 2,
              "column": 3,
              "severity": 4,
              "code": 5,
              "message": 6
            }
          }
        ],
        "presentation": {
          "reveal": "always",
          "panel": "dedicated",
          "focus": false
        },
        "runOptions": {
          "instanceLimit": 1
        },
        "group": {
          "kind": "build",
          "isDefault": true
        }
      },
      {
        "label": "RTC SD: Compilar, subir y monitorear",
        "type": "process",
        "command": "powershell.exe",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "${workspaceFolder:Station RTC SD}/../../../tools/run.ps1",
          "build-upload-monitor",
          "--config",
          "${workspaceFolder:Station RTC SD}/config/project.json"
        ],
        "problemMatcher": [
          {
            "owner": "ccs",
            "source": "CCS 5.081",
            "fileLocation": "absolute",
            "pattern": {
              "regexp": "^(.*):(\\d+):(\\d+):\\s+(error|warning) CCS(\\d+): (.*)$",
              "file": 1,
              "line": 2,
              "column": 3,
              "severity": 4,
              "code": 5,
              "message": 6
            }
          }
        ],
        "presentation": {
          "reveal": "always",
          "panel": "dedicated",
          "focus": true
        },
        "runOptions": {
          "instanceLimit": 1
        }
      },
      {
        "label": "RTC SD: Monitor serie",
        "type": "process",
        "command": "powershell.exe",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "${workspaceFolder:Station RTC SD}/../../../tools/run.ps1",
          "monitor",
          "--config",
          "${workspaceFolder:Station RTC SD}/config/project.json"
        ],
        "problemMatcher": [],
        "presentation": {
          "reveal": "always",
          "panel": "dedicated",
          "focus": true
        },
        "runOptions": {
          "instanceLimit": 1
        }
      },
      {
        "label": "Protolink: Seleccionar puerto COM",
        "type": "process",
        "command": "powershell.exe",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "${workspaceFolder:Station RTC SD}/../../../tools/run.ps1",
          "select-port",
          "--config",
          "${workspaceFolder:Station RTC SD}/config/project.json"
        ],
        "problemMatcher": [],
        "presentation": {
          "reveal": "always",
          "panel": "dedicated",
          "focus": true,
          "clear": true
        },
        "runOptions": {
          "instanceLimit": 1
        }
      },
      {
        "label": "Protolink: Preparar dependencias",
        "type": "process",
        "command": "powershell.exe",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "${workspaceFolder:Station RTC SD}/../../../tools/run.ps1",
          "deps-sync",
          "--config",
          "${workspaceFolder:Station RTC SD}/config/project.json"
        ],
        "problemMatcher": [],
        "presentation": {
          "reveal": "always",
          "panel": "dedicated",
          "focus": true,
          "clear": true
        },
        "runOptions": {
          "instanceLimit": 1
        }
      }
    ]
  },
  "settings": {
    "files.autoSave": "afterDelay",
    "C_Cpp.errorSquiggles": "disabled",
    "C_Cpp.default.includePath": [
      "${workspaceFolder:Station RTC SD}/../../../**",
      "${workspaceFolder:Station RTC SD}/galio",
      "C:/Program Files (x86)/PICC/Devices",
      "C:/Program Files (x86)/PICC/Drivers"
    ]
  }
}
