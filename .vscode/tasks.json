        "select-port"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true,
        "clear": true
      },
      "runOptions": {
        "instanceLimit": 1
      },
      "options": {
        "cwd": "${workspaceFolder}"
      }
    }
  ],
  "inputs": [
    {
      "id": "stationProfile",
      "type": "pickString",
      "description": "Elegir main.c que se compilara",
      "options": [
        "station-master",
        "station-client",
        "station-blink",
        "station-dht22",
        "station-rak3172",
        "station-qdy30a",
        "station-qdy30a-lte"
      ],
      "default": "station-master"
    }
  ]
}
